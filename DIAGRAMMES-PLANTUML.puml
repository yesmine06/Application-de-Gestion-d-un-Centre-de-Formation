@startuml Composants_React_Etudiant
!theme plain
skinparam componentStyle rectangle

package "App Component" {
    component [App] {
        - token: state
        - user: state
        - activeTab: state
        - refreshKey: state
        + handleLogin()
        + handleLogout()
        + handleEnrollSuccess()
        + handleUnenrollSuccess()
    }
}

package "Composants" {
    component [Login] as LoginComp
    component [MyCourses] as MyCoursesComp {
        + loadCourses()
        + handleUnenroll()
    }
    component [AvailableCourses] as AvailableComp {
        + loadData()
        + handleEnroll()
    }
    component [Grades] as GradesComp {
        + loadGrades()
        + loadAverage()
    }
    component [Calendar] as CalendarComp {
        + loadSchedules()
        + getDaysInMonth()
        + getSchedulesForDay()
        + prevMonth()
        + nextMonth()
    }
    component [CourseCard] as CardComp {
        + handleDownload()
    }
}

[App] --> [Login] : if !token
[App] --> [MyCourses] : if activeTab='courses'
[App] --> [AvailableCourses] : if activeTab='available'
[App] --> [Grades] : if activeTab='grades'
[App] --> [Calendar] : if activeTab='schedule'

[MyCourses] --> [CardComp] : renders
[AvailableCourses] --> [CardComp] : renders
[CardComp] --> [CalendarComp] : shows files

note right of [App]
  refreshKey force re-render
  of child components
end note

@enduml

