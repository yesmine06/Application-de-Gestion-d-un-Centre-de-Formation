@startuml Etat_Schedule
!theme plain
state Schedule {
    [*] --> PENDING : create()
    
    PENDING --> APPROVED : approve()
    PENDING --> REJECTED : reject()
    
    APPROVED --> APPROVED : update()
    REJECTED --> REJECTED : update()
    
    APPROVED --> [*] : delete()
    REJECTED --> [*] : delete()
}

note right of PENDING
  Séance créée
  En attente d'approbation
end note

note right of APPROVED
  Séance approuvée
  Visible pour les étudiants
end note

note right of REJECTED
  Séance rejetée
  Non visible
end note

@enduml

