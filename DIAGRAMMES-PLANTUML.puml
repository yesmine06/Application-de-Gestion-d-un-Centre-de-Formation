@startuml Diagramme_Classes
!theme plain
skinparam classAttributeIconSize 0

abstract class User {
    - id : Long
    - username : String
    - password : String
    - email : String
    - nom : String
    - prenom : String
    - enabled : Boolean
    - dateCreation : LocalDateTime
    - roles : Set<Role>
}

class Student {
    - matricule : String
    - dateInscription : LocalDate
}

class Trainer {
    - specialite : String
}

class Role {
    - id : Long
    - name : RoleType
}

enum RoleType {
    ADMIN
    FORMATEUR
    ETUDIANT
}

class Course {
    - id : Long
    - code : String
    - titre : String
    - description : String
}

class Enrollment {
    - id : Long
    - dateInscription : LocalDateTime
}

class Grade {
    - id : Long
    - valeur : Double
    - commentaire : String
    - dateAttribution : LocalDateTime
}

class Schedule {
    - id : Long
    - date : LocalDate
    - heureDebut : LocalTime
    - heureFin : LocalTime
    - salle : String
    - status : ScheduleStatus
}

enum ScheduleStatus {
    PENDING
    APPROVED
    REJECTED
}

class Session {
    - id : Long
    - nom : String
    - type : String
    - dateDebut : LocalDate
    - dateFin : LocalDate
}

class CourseFile {
    - id : Long
    - nomFichier : String
    - typeMime : String
    - taille : Long
    - chemin : String
    - dateUpload : LocalDateTime
}

class Group {
    - id : Long
    - nom : String
    - description : String
}

class Specialty {
    - id : Long
    - nom : String
    - description : String
}

' Relations d'héritage
User <|-- Student
User <|-- Trainer

' Relations User-Role
User "1" --> "*" Role : has

' Relations Student
Student "1" --> "*" Enrollment : has
Student "1" --> "*" Grade : has
Student "N" --> "1" Group : belongs to
Student "N" --> "1" Specialty : has

' Relations Trainer
Trainer "1" --> "*" Course : teaches

' Relations Course
Course "N" --> "1" Trainer : taught by
Course "N" --> "1" Session : belongs to
Course "1" --> "*" Enrollment : has
Course "1" --> "*" Grade : has
Course "1" --> "*" Schedule : has
Course "1" --> "*" CourseFile : has

' Relations Enrollment
Enrollment "N" --> "1" Student : belongs to
Enrollment "N" --> "1" Course : for

' Relations Grade
Grade "N" --> "1" Student : for
Grade "N" --> "1" Course : in

' Relations Schedule
Schedule "N" --> "1" Course : for

@enduml

@startuml Sequence_Authentification_JWT
!theme plain
actor "Client\n(Browser)" as Client
participant "React App" as React
participant "AuthController" as Auth
participant "UserService" as UserService
database "Database" as DB

Client -> React : 1. Login Form\n(username, password)
React -> Auth : 2. POST /api/auth/login\n{username, password}
activate Auth

Auth -> UserService : 3. findByUsername(username)
activate UserService

UserService -> DB : 4. SELECT user WHERE username
activate DB
DB --> UserService : 5. User data
deactivate DB

UserService -> UserService : 6. Validate password\n(BCrypt)
UserService -> Auth : 7. User validated
deactivate UserService

Auth -> Auth : 8. Generate JWT Token

Auth --> React : 9. Response\n{token, userInfo}
deactivate Auth

React -> React : 10. Store token\nin localStorage

React --> Client : 11. Redirect to dashboard

note right of React
  Subsequent requests include:
  Authorization: Bearer <token>
end note

@enduml

@startuml Sequence_Inscription_Cours
!theme plain
actor Étudiant
participant "React App" as React
participant "EnrollmentRestController" as Controller
participant "EnrollmentService" as Service
database "Database" as DB

Étudiant -> React : 1. Click "S'inscrire"
React -> React : 2. Disable button\n(setEnrollingCourseId)

React -> Controller : 3. POST /api/inscriptions\n{studentId, coursId}
activate Controller

Controller -> Service : 4. enroll(studentId, coursId)
activate Service

Service -> DB : 5. Check if exists\n(student_id, cours_id)
activate DB
DB --> Service : 6. Not exists
deactivate DB

Service -> DB : 7. INSERT enrollment
activate DB
DB --> Service : 8. Enrollment saved
deactivate DB

Service -> Controller : 9. EnrollmentDto
deactivate Service

Controller --> React : 10. Success Response\n(201 Created)
deactivate Controller

React -> React : 11. onEnrollSuccess()\n(refreshKey++)

React -> React : 12. Refresh data\n- MyCourses\n- AvailableCourses

React --> Étudiant : 13. UI Updated\n- Course in "Mes Cours"\n- Removed from "Disponibles"

@enduml

